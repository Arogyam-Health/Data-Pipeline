# --- Supabase ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Shiprocket ---
SHIPROCKET_WEBHOOK_SECRET=
# Existing Apps Script Web App URL (include ?hook_key= if that is how it is deployed).
# Required before switching Shiprocket's single webhook URL to this app.
# Never commit the real URL.
SHIPROCKET_APPS_SCRIPT_WEBHOOK_URL=

# --- Pabbly (keep false during parallel validation — Apps Script still sends production) ---
PABBLY_SHIPROCKET_URL=
SHIPROCKET_PABBLY_ENABLED=false
# Print the full incoming webhook JSON to the server console (Vercel logs / local terminal).
# true = print, false = off. Do not leave true in production longer than needed.
SHIPROCKET_LOG_WEBHOOK_PAYLOAD=false
SHIPROCKET_INTERNAL_SYNC_SECRET=

# --- Worker ---
WORKER_SECRET=

# --- App ---
NODE_ENV=development

# --- Shopify (server-side only; never use NEXT_PUBLIC_*) ---
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-04
SHOPIFY_SYNC_ENABLED=false
SHOPIFY_SYNC_INTERVAL_MINUTES=15
SHOPIFY_INTERNAL_SYNC_SECRET=
# Vercel Cron sends Authorization: Bearer $CRON_SECRET. Use the same value as SHOPIFY_INTERNAL_SYNC_SECRET.
CRON_SECRET=
SHOPIFY_BACKFILL_DAYS=90
SHOPIFY_TEST_FETCH_DAYS=3
SHOPIFY_INCREMENTAL_BUFFER_MINUTES=10
SHOPIFY_PAGE_SIZE=100
SHOPIFY_MAX_FETCH_RETRIES=6
SHOPIFY_BACKFILL_CHUNK_DAYS=3

# --- Dashboard protection (Shopify/Meta/GA4/Shiprocket explorer + matching APIs) ---
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# --- Meta Ads (server-side only; never use NEXT_PUBLIC_*) ---
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=v23.0
META_SYNC_ENABLED=false
META_INTERNAL_SYNC_SECRET=
META_BACKFILL_DAYS=90
META_BACKFILL_CHUNK_DAYS=3
META_PAGE_LIMIT=500
META_MAX_RETRIES=5
META_RECENT_REPAIR_DAYS=2
META_EXTENDED_INSIGHTS_ENABLED=false
META_METADATA_SYNC_ENABLED=false
META_BREAKDOWN_SYNC_ENABLED=false

# --- GA4 (Vercel OIDC + Google WIF only; never use a private key or NEXT_PUBLIC_*) ---
GA4_PROPERTY_ID=
GCP_PROJECT_ID=
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
GA4_SYNC_ENABLED=false
GA4_INTERNAL_SYNC_SECRET=
GA4_DAILY_BACKFILL_DAYS=90
GA4_DAILY_BACKFILL_CHUNK_DAYS=3
GA4_CHANNEL_BACKFILL_DAYS=90
GA4_CHANNEL_BACKFILL_CHUNK_DAYS=3
GA4_UTM_BACKFILL_START_DATE=2025-10-14
GA4_UTM_BACKFILL_CHUNK_DAYS=30
GA4_RECENT_DAYS_BACK=2
GA4_API_PAGE_LIMIT=250000
GA4_MAX_RETRIES=5
GA4_BASE_RETRY_MS=3000
GA4_REPORTING_TIMEZONE=
GA4_CURRENCY=
