# --- Supabase ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Shiprocket ---
SHIPROCKET_WEBHOOK_SECRET=

# --- Pabbly ---
PABBLY_SHIPROCKET_URL=
SHIPROCKET_PABBLY_ENABLED=false

# --- Worker ---
WORKER_SECRET=

# --- App ---
NODE_ENV=development

# --- Shopify (server-side only; never use NEXT_PUBLIC_*) ---
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-04
SHOPIFY_SYNC_ENABLED=false
SHOPIFY_SYNC_INTERVAL_MINUTES=15
SHOPIFY_INTERNAL_SYNC_SECRET=
SHOPIFY_BACKFILL_DAYS=90
SHOPIFY_TEST_FETCH_DAYS=3
SHOPIFY_INCREMENTAL_BUFFER_MINUTES=10
SHOPIFY_PAGE_SIZE=100
SHOPIFY_MAX_FETCH_RETRIES=6
SHOPIFY_BACKFILL_CHUNK_DAYS=3

# --- Dashboard protection (Shopify dashboard + /api/shopify) ---
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
